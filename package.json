{
  "name": "scan-auditor",
  "version": "1.0.0",
  "description": "Medical Records Analysis Tool using AI",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder",
    "postinstall": "electron-builder install-app-deps"
  },
  "keywords": [
    "medical",
    "records",
    "analysis",
    "ai",
    "ollama"
  ],
  "author": "ScanAuditor Team",
  "license": "MIT",
  "devDependencies": {
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1"
  },
  "dependencies": {
    "axios": "^1.6.0",
    "cors": "^2.8.5",
    "express": "^4.18.2",
    "fs-extra": "^11.1.1",
    "multer": "^1.4.5-lts.1",
    "path": "^0.12.7",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^1.1.1",
    "pdf-poppler": "^0.2.1",
    "pdfjs-dist": "^5.4.54",
    "sharp": "^0.34.3"
  },
  "build": {
    "appId": "com.scanauditor.app",
    "productName": "ScanAuditor",
    "directories": {
      "output": "dist"
    },
    "files": [
      "**/*",
      "!node_modules/**/*",
      "!dist/**/*",
      "!src/**/*"
    ],
    "win": {
      "target": "nsis"
    }
  }
}
